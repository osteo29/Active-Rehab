{
    "name": "react-example",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --port=3000 --host=0.0.0.0",
        "generate:sitemap": "tsx scripts/generate-sitemap.ts",
        "generate:prerender": "tsx generate-prerender.ts",
        "import:injury-protocols": "tsx scripts/import-raw-injury-protocols.ts",
        "rehab:build": "node scripts/generate-rehab-protocols.mjs",
        "prebuild": "npm run generate:sitemap",
        "build": "vite build",
        "postbuild": "npm run generate:prerender",
        "preview": "vite preview",
        "clean": "rimraf dist",
        "lint": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "report:injury-content": "tsx scripts/generate-injury-content-report.ts",
        "organize:injury-data": "tsx scripts/organize-injury-data.ts",
        "protocols:sync": "tsx scripts/organize-injury-data.ts --sync-supabase",
        "rehab:sync-supabase": "tsx scripts/sync-rehab-protocols-to-supabase.ts"
    },
    "dependencies": {
        "@google/genai": "^1.29.0",
        "@supabase/supabase-js": "^2.99.2",
        "@tailwindcss/vite": "^4.1.14",
        "@vitejs/plugin-react": "^5.0.4",
        "chart.js": "^4.5.1",
        "dotenv": "^17.2.3",
        "express": "^4.21.2",
        "html2canvas": "^1.4.1",
        "jspdf": "^4.2.0",
        "lucide-react": "^0.546.0",
        "motion": "^12.23.24",
        "qrcode": "^1.5.4",
        "react": "^19.0.0",
        "react-chartjs-2": "^5.3.1",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.9.1",
        "vite": "^6.2.0"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/express": "^4.17.21",
        "@types/node": "^22.14.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "autoprefixer": "^10.4.21",
        "jsdom": "^29.0.2",
        "rimraf": "^6.0.1",
        "sharp": "^0.35.5",
        "supabase": "^2.101.0",
        "tailwindcss": "^4.1.14",
        "tsx": "^4.21.0",
        "typescript": "~5.8.2",
        "vite": "^6.2.0",
        "vitest": "^4.1.4"
    }
}
