{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Frame-Options": "SAMEORIGIN",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "accelerometer=(), camera=(), microphone=(), geolocation=(), payment=(), usb=()"
      },
      "continue": true
    },
    {
      "src": "/(assistant|auth|dashboard)(/.*)?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/(en|ar)/(assistant|auth|dashboard)(/.*)?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/(admin|studio)(/.*)?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/(en|ar)/(admin|studio)(/.*)?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "max-age=0, must-revalidate, public"
      },
      "continue": true
    },
    {
      "src": "/(.*).html",
      "headers": {
        "Cache-Control": "no-cache, public, must-revalidate"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(en|ar)/muscles",
      "status": 301,
      "headers": {
        "Location": "/$1/anatomy"
      }
    },
    {
      "src": "/(en|ar)/injuries/perthes-disease",
      "status": 301,
      "headers": {
        "Location": "/$1/injuries/perthes-disease-rehabilitation"
      }
    },
    {
      "src": "/(en|ar)/injuries/carpal-tunnel-syndrome",
      "status": 301,
      "headers": {
        "Location": "/$1/injuries/carpal-tunnel-syndrome-conservative"
      }
    },
    {
      "src": "/(en|ar)/injuries/rotator-cuff-repair",
      "status": 301,
      "headers": {
        "Location": "/$1/injuries/rotator-cuff-repair-post-operative"
      }
    },
    {
      "src": "/(en|ar)/injuries/cervical-disc-herniation",
      "status": 301,
      "headers": {
        "Location": "/$1/injuries/cervical-radiculopathy"
      }
    },
    {
      "src": "/(en|ar)/injuries/ankle-fracture-orif-rehab",
      "status": 301,
      "headers": {
        "Location": "/$1/injuries/ankle-fracture-orif-post-operative"
      }
    },
    {
      "src": "/(en|ar)/injuries/femoroacetabular-impingement",
      "status": 301,
      "headers": {
        "Location": "/$1/injuries/femoroacetabular-impingement-fai"
      }
    },
    {
      "src": "/(en|ar)/injuries/complex-regional-pain-syndrome-crps-type-i",
      "status": 301,
      "headers": {
        "Location": "/$1/injuries/complex-regional-pain-syndrome"
      }
    },
    {
      "src": "/.*\\.(xml|txt)$",
      "status": 404
    },
    {
      "src": "/(en|ar)(/)?",
      "dest": "/index.html"
    },
    {
      "src": "/((en|ar)/)?(calculators|privacy|terms|cookies|disclaimer|about|contact|insights|injury-protocols|injuries|admin|studio|assistant|auth|dashboard|diets|exercises|anatomy|muscles)(/.*)?",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ],
  "env": {
    "VITE_SITE_URL": "https://activerehab.vercel.app"
  }
}
